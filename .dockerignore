# Version control
.git
.github
.githooks
.gitignore

# IDE / editor
.claude
.vscode
.idea
*.swp
*.swo

# Dependencies (reinstalled in Docker)
node_modules

# Sidecar (Go binary, not included in Docker image)
sidecar/

# Documentation (not needed at runtime)
docs/
VISION.md
QUICKSTART.md
SECURITY_AUDIT_DOCUMENTS.md
CLAUDE.md
CHANGELOG.md
LICENSE

# Build artifacts
*.tgz
coverage/
*.lcov
out/

# UI build output (rebuilt in Docker)
ui/dist/

# Compiled bundles under src/ (rebuilt in Docker by the `workflows` stage).
# These are untracked build output, so a developer's working tree may hold
# them, and excluding them keeps `docker build` from shipping locally built
# bytes when their content hash happens to match. Deliberately every dist/
# under src/, not just the jarvis pieces: the engine's piece loader walks
# packages/pieces/** for any dist/package.json, so a stray local build under
# a sibling package would ship and be loadable.
src/**/dist/

# ONNX/WASM assets (copied from node_modules in Docker)
ui/public/openwakeword/
ui/public/ort/

# Env files (secrets — pass via env vars or volume mount)
.env
.env.*
.secrets.*

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
data/

# Large training data (tesseract.js manages its own)
eng.traineddata

# Misc
todos/
examples/
*.heapsnapshot
*.log
trace.json*
.DS_Store
.npmignore
install.sh
config.example.yaml
