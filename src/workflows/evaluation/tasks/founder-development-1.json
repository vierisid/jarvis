    {
      "id": "dev-overdue-loop",
      "split": "development",
      "category": "invoice_review",
      "specification": {
        "schemaVersion": 1,
        "name": "dev-overdue-loop",
        "description": "On a webhook, bills is a list of invoices with a boolean overdue and a string reference. For each overdue invoice send its reference exactly to dashboard. Never send anything for invoices that are not overdue. Use a loop, not AI."
      },
      "expectation": {
        "trigger": {
          "kind": "webhook"
        },
        "maxAiSteps": 0,
        "blocked": false,
        "negativeConstraints": [
          "No email, Slack or external messages unless the job asks for them.",
          "Use only installed pieces, listed tools and named machines."
        ],
        "forbidden": {
          "agents": true
        }
      },
      "scenarios": [
        {
          "id": "mixed",
          "payload": {
            "bills": [
              {
                "overdue": true,
                "reference": "B-301"
              },
              {
                "overdue": false,
                "reference": "B-302"
              }
            ]
          },
          "notifications": [
            {
              "message": "B-301",
              "channels": [
                "dashboard"
              ]
            }
          ]
        },
        {
          "id": "empty",
          "payload": {
            "bills": []
          },
          "notifications": []
        }
      ]
    },
