  "tasks": [
    {
      "id": "dev-weekly-notes-file",
      "split": "development",
      "category": "recurring_report",
      "specification": {
        "schemaVersion": 1,
        "name": "dev-weekly-notes-file",
        "description": "Every Friday at 17:00 (cron 0 17 * * 5), write exactly \"Weekly review due\" to /Users/founder/notes/weekly.txt on the Office Mac. Nothing else."
      },
      "expectation": {
        "trigger": {
          "kind": "schedule",
          "cron": "0 17 * * 5"
        },
        "maxAiSteps": 0,
        "blocked": false,
        "negativeConstraints": [
          "No email, Slack or external messages unless the job asks for them.",
          "Use only installed pieces, listed tools and named machines."
        ],
        "forbidden": {
          "agents": true
        }
      },
      "scenarios": [
        {
          "id": "allowed",
          "payload": {},
          "notifications": [],
          "tools": [
            {
              "toolName": "write_file",
              "params": {
                "path": "/Users/founder/notes/weekly.txt",
                "content": "Weekly review due",
                "target": "Office Mac"
              }
            }
          ]
        },
        {
          "id": "needs-approval",
          "payload": {},
          "notifications": [],
          "tools": [
            {
              "toolName": "write_file",
              "params": {
                "path": "/Users/founder/notes/weekly.txt",
                "content": "Weekly review due",
                "target": "Office Mac"
              },
              "outcome": "approval_pending"
            }
          ],
          "status": "PAUSED",
          "sandbox": {
            "approvals": [
              "write_file"
            ]
          }
        }
      ]
    },
    {
      "id": "dev-studio-screen",
      "split": "development",
      "category": "recurring_report",
      "specification": {
        "schemaVersion": 1,
        "name": "dev-studio-screen",
        "description": "Every weekday at 08:00 (cron 0 8 * * 1-5), capture the screen on the Studio PC, then post exactly \"Studio screen captured\" to the dashboard. If the capture fails, post nothing."
      },
      "expectation": {
        "trigger": {
          "kind": "schedule",
          "cron": "0 8 * * 1-5"
        },
        "maxAiSteps": 0,
        "blocked": false,
        "negativeConstraints": [
          "No email, Slack or external messages unless the job asks for them.",
          "Use only installed pieces, listed tools and named machines."
        ]
      },
      "scenarios": [
        {
          "id": "online",
          "payload": {},
          "notifications": [
            {
              "message": "Studio screen captured",
              "channels": [
                "dashboard"
              ]
            }
          ],
          "tools": [
            {
              "toolName": "capture_screen",
              "params": {
                "target": "Studio PC"
              }
            }
          ]
        },
        {
          "id": "offline",
          "payload": {},
          "notifications": [],
          "tools": [
            {
              "toolName": "capture_screen",
              "params": {
                "target": "Studio PC"
              },
              "outcome": "blocked"
            }
          ],
          "status": "FAILED",
          "sandbox": {
            "offlineTargets": [
              "Studio PC"
            ]
          }
        }
      ]
    },
    {
      "id": "dev-company-brief",
      "split": "development",
      "category": "meeting_followup",
      "specification": {
        "schemaVersion": 1,
        "name": "dev-company-brief",
        "description": "On a webhook with a company field, search my memory for that company, ask Jarvis once to write a one-line brief from what memory returns, and post only that brief to the dashboard."
      },
      "expectation": {
        "trigger": {
          "kind": "webhook"
        },
        "maxAiSteps": 1,
        "blocked": false,
        "negativeConstraints": [
          "No email, Slack or external messages unless the job asks for them.",
          "Use only installed pieces, listed tools and named machines."
        ],
        "forbidden": {
          "agents": true
        }
      },
      "scenarios": [
        {
          "id": "known",
          "payload": {
            "company": "Cedar Labs"
          },
          "notifications": [
            {
              "message": "SIMULATED BRIEF",
              "channels": [
                "dashboard"
              ]
            }
          ],
          "ai": {
            "reply": "SIMULATED BRIEF",
            "promptIncludes": [
              "Cedar Labs",
              "renewal in March"
            ]
          },
          "sandbox": {
            "entities": [
              {
                "id": "e1",
                "type": "concept",
                "name": "Cedar Labs",
                "properties": {
                  "note": "renewal in March"
                }
              },
              {
                "id": "e2",
                "type": "concept",
                "name": "Birch Co",
                "properties": {
                  "note": "churned"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "dev-draft-thanks",
      "split": "development",
      "category": "meeting_followup",
      "specification": {
        "schemaVersion": 1,
        "name": "dev-draft-thanks",
        "description": "When a webhook arrives, create a Gmail draft (do not send) with the connection founder-gmail to ana@cedar.test, subject \"Thanks for today\", body \"Great meeting. Notes to follow.\""
      },
      "expectation": {
        "trigger": {
          "kind": "webhook"
        },
        "maxAiSteps": 0,
        "blocked": false,
        "negativeConstraints": [
          "No email, Slack or external messages unless the job asks for them.",
          "Use only installed pieces, listed tools and named machines."
        ],
        "forbidden": {
          "actions": [
            "@activepieces/piece-gmail:send_email"
          ]
        },
        "external": [
          {
            "piece": "@activepieces/piece-gmail",
            "action": "gmail_create_draft",
            "connection": "founder-gmail",
            "input": {
              "receiver": [
                "ana@cedar.test"
              ],
              "subject": "Thanks for today",
              "body": "Great meeting. Notes to follow."
            }
          }
        ]
      },
      "scenarios": []
    },
